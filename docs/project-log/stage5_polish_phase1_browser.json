  "tooltip_texts": [
    {
      "label": "About Net sales",
      "text": "Product sales after returns in the last 12 months, for customers we can identify. This is revenue, not profit."
    },
    {
      "label": "About Customers",
      "text": "Customers who bought in the last 12 months. The note below shows all retained accounts, including those who have not bought recently."
    },
    {
      "label": "About Returns",
      "text": "The share of invoices that record a return in the last 12 months. A return may cover only part of an order."
    },
    {
      "label": "About Expected profit from the campaign",
      "text": "Extra profit we expect from the proposed campaign after its costs. It depends on our assumptions about offer responses and margin."
    },
    {
      "label": "About Customer",
      "text": "The customer\u2019s identifier in the source data."
    },
    {
      "label": "About Days since last purchase",
      "text": "Days from the customer\u2019s last recorded purchase to 9 December 2011."
    },
    {
      "label": "About Purchases",
      "text": "The number of days on which this customer bought something in the retained history. Several orders on one day count as one purchase."
    },
    {
      "label": "About Customer age (days)",
      "text": "Days from the customer\u2019s first recorded purchase to 9 December 2011. This is the length of their recorded history, not their personal age."
    },
    {
      "label": "About Probability of buying \u00b7 90 days",
      "text": "The estimated chance that the customer buys at least once in the next 90 days, even if we do nothing. It is not a guarantee."
    },
    {
      "label": "About Expected spend \u00b7 90 days",
      "text": "What we expect the customer to spend in the next 90 days even if we do nothing."
    },
    {
      "label": "About Reset proposal",
      "text": "Restore the starting budget, coupon limit and assumptions for the proposal."
    },
    {
      "label": "About Budget (\u00a3)",
      "text": "The most we are willing to spend on emails and coupons."
    },
    {
      "label": "About Maximum coupons",
      "text": "A ceiling on coupons, not a target."
    },
    {
      "label": "About Advanced assumptions",
      "text": "Change the assumed margin, offer responses, costs and coupon discount used in the proposal."
    },
    {
      "label": "About Margin (assumption, %)",
      "text": "The share of each pound of sales left after product costs, before campaign costs. This is an assumption, not measured from these data."
    },
    {
      "label": "About Response to email (assumption, %)",
      "text": "The assumed share of customers who would not otherwise buy but buy because of an email. An A/B test would help estimate this."
    },
    {
      "label": "About Response to coupon (assumption, %)",
      "text": "The assumed share of customers who would not otherwise buy but buy because of a coupon. An A/B test would help estimate this."
    },
    {
      "label": "About Email cost (\u00a3)",
      "text": "The cost of sending one email, whether or not the customer buys."
    },
    {
      "label": "About Coupon fixed cost (\u00a3)",
      "text": "The fixed cost of offering one coupon, before any discount on a purchase."
    },
    {
      "label": "About Coupon discount (%)",
      "text": "The share taken off the purchase price when a customer uses the coupon."
    },
    {
      "label": "About No contact",
      "text": "Customers we propose leaving without an email or coupon. No messages are sent from this demo."
    },
    {
      "label": "About Email",
      "text": "Customers we propose sending an email to. This is a proposed action, not a confirmed purchase."
    },
    {
      "label": "About Coupon",
      "text": "Customers we propose offering a coupon to. This is a proposed action, not a confirmed purchase."
    },
    {
      "label": "About Total expected cost",
      "text": "What we expect to spend on emails, coupon costs and discounts for this proposal. It can be less than the budget."
    },
    {
      "label": "About Expected profit",
      "text": "Extra profit we expect from the proposed campaign after its costs. It depends on our assumptions about offer responses and margin."
    },
    {
      "label": "About Return on investment (ROI)",
      "text": "Expected extra profit divided by expected campaign cost. For example, \u00a35.43 means \u00a35.43 profit for each \u00a31 spent. It depends on our assumptions."
    },
    {
      "label": "About Customer",
      "text": "The customer\u2019s identifier in the source data."
    },
    {
      "label": "About Recommended action",
      "text": "The action proposed for this customer under the current budget, coupon limit and assumptions."
    },
    {
      "label": "About Days since last purchase",
      "text": "Days from the customer\u2019s last recorded purchase to 9 December 2011."
    },
    {
      "label": "About Expected spend \u00b7 90 days",
      "text": "What we expect the customer to spend in the next 90 days even if we do nothing."
    },
    {
      "label": "About Expected gain",
      "text": "Extra profit we expect from this action after its cost; it depends on our assumption of how customers respond to the offer."
    },
    {
      "label": "About Contacted-customer realized spend",
      "text": "What the customers selected by this proposal actually spent in the historical check. These purchases happened without this campaign."
    },
    {
      "label": "About Share of eligible spend",
      "text": "The share of all eligible customers\u2019 actual spending covered by the selected customers in the historical check. It does not show extra sales caused by a campaign."
    }
