      "external_connect_blocked": true
    },
    "etl": {
      "target": "1.1.1.1:443",
      "connect_ex": 101,
      "external_connect_blocked": true
    },
    "model": {
      "target": "1.1.1.1:443",
      "connect_ex": 101,
      "external_connect_blocked": true
    },
    "postgres": {
      "target": "1.1.1.1:443",
